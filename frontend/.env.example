# WasteChakra Frontend Environment Variables
# Copy this file to .env and adjust values as needed.

# Optional: override the backend API base URL.
# Defaults: dev -> http://localhost:8000/api/v1 , prod -> https://buildsprint-wastechakra.onrender.com/api/v1
# VITE_API_URL=https://buildsprint-wastechakra.onrender.com/api/v1

# Force demo data on (true/1) — useful for presentations without a live backend.
# When disabled, pages try the live API and fall back to built-in demo data on failure.
# VITE_DEMO_MODE=true

# Show quick-fill demo account buttons on the Login page in production.
# In local development (npm run dev), demo accounts are always shown automatically.
# VITE_SHOW_DEMO_ACCOUNTS=true